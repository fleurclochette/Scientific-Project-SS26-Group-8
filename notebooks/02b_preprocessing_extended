# Calculating log returns
df["LogReturn"] = (
    np.log(
        df["Close"] / df["Close"].shift(1)
    )
) * 100
# The first observation has no previous closing price,
# so its log return is undefined and is removed.
df = df.dropna(
    subset=["LogReturn"]
)
     

# Save the processed dataset
df.to_csv(
    processed_data_path,
    index=False
)

print("\n" + "-" * 60)
